# Copy to .env and fill in. .env is gitignored; never commit the real token.
# An exported HF_TOKEN takes precedence over this file.
HF_TOKEN=hf_your_token_here

# YouTube Data API v3 key (Google Cloud console -> APIs & Services -> Credentials).
# Used by scraping/video_scraping/youtube_scrape.py. An exported YOUTUBE_API_KEY wins.
YOUTUBE_API_KEY=your_key_here

# Optional proxy for YouTube video DOWNLOADS (scraping/video_scraping/youtube_download.py,
# used by the shot scan). Tried only after the direct route is refused (stream 403 /
# bot check); a new run tries direct again. Any yt-dlp proxy URL, e.g.
#   http://user:pass@host:port   or   socks5://127.0.0.1:1080 (ssh -D 1080 -N other-host)
# An exported YTDLP_PROXY wins. Leave unset for direct only.
YTDLP_PROXY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
